+      for(int i=0;i<4;i++){
+        string backup=System.IO.Path.Combine(dir,"snapshot_"+i+".db");db.BackupTo(backup);
+        using(var snapshot=new VihanSqliteDb(backup)){
+          Check(snapshot.ScalarText("PRAGMA quick_check","")=="ok","SQLite snapshot integrity "+i);
