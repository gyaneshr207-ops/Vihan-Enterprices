+      db.Exec("INSERT INTO entries VALUES(1,"+VihanSqliteDb.Quote("नाम O'Brien")+");");
+      Check(db.ScalarText("SELECT name FROM entries WHERE id=1","")=="नाम O'Brien","Unicode, spaces and quoted data save/read");
+      bool failed=false;try{db.Exec("BEGIN IMMEDIATE;INSERT INTO entries VALUES(2,'must rollback');INSERT INTO missing_table VALUES(1);COMMIT;");}catch{failed=true;}
+      Check(failed&&db.ScalarLong("SELECT COUNT(*) FROM entries WHERE id=2",-1)==0,"Failed group commit rolls back all partial writes");
+      db.Exec("BEGIN IMMEDIATE;INSERT INTO entries VALUES(3,'after failure');COMMIT;");
+      Check(db.ScalarLong("SELECT COUNT(*) FROM entries",0)==2,"Connection can save after a failed transaction");
