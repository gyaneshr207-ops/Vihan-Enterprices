+    }
+  }
+  if(!$activeAdmins){throw 'At least one active Admin must remain'}
+  $op=[pscustomobject]@{key='multiCompanyAdminV2';value=($root|ConvertTo-Json -Depth 100 -Compress);op='set';expectedRev=[long]$Body.expectedRev;seq=0}
+  $plan=Plan-Ops @($op) 'credential-admin'
