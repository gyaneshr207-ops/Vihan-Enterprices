+    if(!$c.id -or $seen.ContainsKey([string]$c.id)){throw 'Unique company id required'};$seen[[string]$c.id]=$true;$names=@{}
+    foreach($u in @($c.users)){
+      if(!$u.username -or $names.ContainsKey([string]$u.username)){throw 'Unique user name required'};$names[[string]$u.username]=$true
+      $previous=@($old.companies|Where-Object{[string]$_.id -ceq [string]$c.id}|ForEach-Object{$_.users}|Where-Object{[string]$_.username -ceq [string]$u.username})
