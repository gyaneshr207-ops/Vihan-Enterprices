+import { xchacha20poly1305 } from '@noble/ciphers/chacha';
+const text=new TextEncoder(),decoder=new TextDecoder();
+function to64(bytes){let out='';for(let i=0;i<bytes.length;i+=32768)out+=String.fromCharCode(...bytes.subarray(i,i+32768));return btoa(out)}
+function from64(s){s=String(s).replace(/-/g,'+').replace(/_/g,'/');return Uint8Array.from(atob(s),c=>c.charCodeAt(0))}
+function aad(e){return text.encode(JSON.stringify({version:1,owner:e.owner,kid:e.kid}))}
+export function seal(key,body,owner,kid){const e={version:1,owner,kid},nonce=crypto.getRandomValues(new Uint8Array(24));e.nonce=to64(nonce);e.box=to64(xchacha20poly1305(from64(key),nonce,aad(e)).encrypt(text.encode(body)));return e}
+export function open(key,e){if(e?.version!==1||typeof e.owner!=='string'||typeof e.kid!=='string')throw Error('Invalid private draft');return decoder.decode(xchacha20poly1305(from64(key),from64(e.nonce),aad(e)).decrypt(from64(e.box)))}
