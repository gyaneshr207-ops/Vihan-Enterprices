+function Invoke-VihanCredentialRoot($Context,$Identity,$Body) {
+  if($Identity.type -ne 'admin'){Send-Json $Context @{error='Admin required'} 403;return}
+  $root=$Body.value|ConvertFrom-Json;$old=Get-VihanRoot
+  $seen=@{};$activeAdmins=0
