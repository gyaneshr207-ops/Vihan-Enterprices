+# Offline/staged preparation ONLY: never switches a production database or rewrites server.json.
+param([Parameter(Mandatory=$true)][string]$SourceDatabase,[Parameter(Mandatory=$true)][string]$OutputDirectory,[switch]$PrepareCopy)
+$ErrorActionPreference='Stop'
+if(![IO.Path]::IsPathRooted($SourceDatabase) -or ![IO.Path]::IsPathRooted($OutputDirectory)){throw 'Absolute paths required'}
+if(!(Test-Path -LiteralPath $SourceDatabase -PathType Leaf)){throw 'Existing source database required'}
+if(Test-Path -LiteralPath $OutputDirectory){throw 'Output must be a new directory; no existing files will be overwritten'}
+if(!$PrepareCopy){Write-Output 'PLAN ONLY: no database opened or changed. PrepareCopy creates a separate verified credential-migration candidate; switching production still needs explicit operator approval.';return}
+if(-not ('VihanSqliteDb' -as [type])){Add-Type -Path (Join-Path $PSScriptRoot 'VihanSqlite.cs')}
+if(-not ('VihanAuthCrypto' -as [type])){Add-Type -Path (Join-Path $PSScriptRoot 'VihanAuthCrypto.cs')}
+New-Item -ItemType Directory -Path $OutputDirectory|Out-Null
+# A plaintext safety snapshot is retained deliberately; on Windows restrict access before writing it.
+if($env:OS -eq 'Windows_NT'){
+  & icacls.exe $OutputDirectory /inheritance:r /grant:r (($env:USERDOMAIN+'\'+$env:USERNAME)+':(OI)(CI)F') 'SYSTEM:(OI)(CI)F' 'Administrators:(OI)(CI)F'|Out-Null
+  if($LASTEXITCODE -ne 0){throw 'Cannot restrict migration/safety directory; stopped before database copy'}
+}
+$mutex=New-Object Threading.Mutex($false,'Global\VihanEnterpricesDataIO');$held=$false;$source=$null;$candidate=$null
+try{
+ try{$held=$mutex.WaitOne(30000)}catch [Threading.AbandonedMutexException]{$held=$true};if(!$held){throw 'Data operations busy; retry'}
+ $source=New-Object VihanSqliteDb -ArgumentList $SourceDatabase
