+# Shared by Main and File service; identity always comes from server-side sessions.
+function Initialize-VihanSecurity {
+  if(-not ('VihanAuthCrypto' -as [type])){Add-Type -Path (Join-Path $PSScriptRoot 'VihanAuthCrypto.cs')}
+  $db.Exec("CREATE TABLE IF NOT EXISTS auth_sessions(token_hash TEXT PRIMARY KEY,company_id TEXT NOT NULL,username TEXT NOT NULL,login_type TEXT NOT NULL,fingerprint TEXT NOT NULL,expires INTEGER NOT NULL);CREATE TABLE IF NOT EXISTS auth_attempts(identity TEXT PRIMARY KEY,failures INTEGER NOT NULL,window_start INTEGER NOT NULL);CREATE TABLE IF NOT EXISTS auth_draft_keys(identity_hash TEXT PRIMARY KEY,key_id TEXT UNIQUE NOT NULL,draft_key TEXT NOT NULL,owner_text TEXT NOT NULL);")
+}
+function Convert-VihanCanonical($Value) {
+  if($null -eq $Value -or $Value -is [string] -or $Value -is [ValueType]){return $Value}
+  if($Value -is [System.Collections.IDictionary]){$result=[ordered]@{};foreach($key in @($Value.Keys|Sort-Object -CaseSensitive)){$result[$key]=Convert-VihanCanonical $Value[$key]};return $result}
+  if($Value -is [System.Collections.IEnumerable]){return ,@($Value|ForEach-Object{Convert-VihanCanonical $_})}
+  $result=[ordered]@{};foreach($p in @($Value.PSObject.Properties|Sort-Object Name -CaseSensitive)){$result[$p.Name]=Convert-VihanCanonical $p.Value};return $result
+}
+function Get-VihanCanonicalJson($Value){return (ConvertTo-Json -InputObject (Convert-VihanCanonical $Value) -Depth 100 -Compress)}
+function Get-VihanRoot {
+  $v=$db.ScalarText("SELECT value FROM kv WHERE key='multiCompanyAdminV2' AND deleted=0",'')
+  if(!$v){return [pscustomobject]@{companies=@()}}
+  try{return ($v|ConvertFrom-Json)}catch{throw 'Identity store is invalid; Main Admin must review a verified backup. No reset performed.'}
+}
+function Get-VihanUser($Identity) {
+  $root=Get-VihanRoot
+  $c=@($root.companies|Where-Object{[string]$_.id -ceq [string]$Identity.companyId -and $_.active -ne $false})
+  if($c.Count -ne 1){return $null}
+  $u=@($c[0].users|Where-Object{[string]$_.username -ceq [string]$Identity.username -and $_.active -ne $false})
+  if($u.Count -ne 1){return $null}
+  if($Identity.type -eq 'admin' -and $u[0].role -cne 'Admin'){return $null}
+  return $u[0]
+}
